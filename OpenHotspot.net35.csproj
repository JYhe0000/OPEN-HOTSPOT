<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>OpenHotspot</AssemblyName>
    <StartupObject>OpenHotspot.Program</StartupObject>
    <ApplicationIcon Condition="'$(OS)' != 'Windows_NT'">app.ico</ApplicationIcon>
    <Win32Icon Condition="'$(OS)' != 'Windows_NT'">app.ico</Win32Icon>
    <LangVersion>3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.Security" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="AppConfig.cs" />
    <Compile Include="MainForm.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Core\HotspotService.cs" />
    <Compile Include="Core\IcsManager.cs" />
    <Compile Include="Core\NetshRunner.cs" />
    <Compile Include="Core\NetworkInventory.cs" />
    <None Include="app.manifest" />
  </ItemGroup>
</Project>
